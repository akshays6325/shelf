{
  "repo": "akshays6325/shelf",
  "apps": [
    {
      "id": "shelf",
      "name": "Shelf",
      "description": "Your private app store. Installs and updates your own apps, in the background where Android allows it.",
      "dir": "android",
      "build": "bash build-apk.sh",
      "apk": "dist/shelf.apk",
      "version": {
        "file": "app/build.gradle.kts",
        "code": "versionCode = (\\d+)",
        "name": "versionName = \"([^\"]+)\""
      }
    },
    {
      "id": "cleantube",
      "name": "CleanTube",
      "description": "Native YouTube client with no Shorts and no ads. Background play, picture-in-picture, SponsorBlock, downloads and captions.",
      "dir": "../cleantube",
      "build": "bash build-apk.sh",
      "apk": "dist/cleantube.apk",
      "smoke": {
        "url": "https://www.youtube.com/watch?v=aqz-KE-bpKQ",
        "logTag": "CleanTubePlayback",
        "logText": "Video is playing"
      },
      "version": {
        "file": "app/build.gradle.kts",
        "code": "versionCode = (\\d+)",
        "name": "versionName = \"([^\"]+)\""
      }
    },
    {
      "id": "insta-no-reels",
      "name": "Insta",
      "description": "Instagram without Reels. Feed, stories and messages, with every Reel link and tab removed.",
      "dir": "../insta-no-reels/android-native",
      "build": "bash build.sh",
      "apk": "../dist/insta-no-reels.apk",
      "version": {
        "file": "build.sh",
        "code": "--version-code (\\d+)",
        "name": "--version-name (\\S+)"
      }
    },
    {
      "id": "repline",
      "name": "Repline",
      "description": "Strength workout tracker with 3D exercise demos. Works offline, with optional cloud backup.",
      "dir": "../repline",
      "build": "bash scripts/shelf-build.sh",
      "apk": "dist/repline.apk",
      "version": {
        "file": "app.json",
        "code": "\"versionCode\": (\\d+)",
        "name": "\"version\": \"([^\"]+)\""
      }
    }
  ]
}
